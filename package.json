{
  "name": "studio-app",
  "version": "1.0.0",
  "description": "Studio Financial Management Web App",
  "main": "server/server.js",
  "scripts": {
    "postinstall": "npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build && node -e \"const fs=require('fs'); fs.cpSync('client/dist', 'public', {recursive:true}); fs.cpSync('client/dist', 'dist', {recursive:true});\"",
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sql.js": "^1.14.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  }
}
